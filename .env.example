# Postgres / Redis (see docker-compose.yml for local port mapping)
DATABASE_URL=postgresql+psycopg://milieu:milieu@localhost:5544/milieu
REDIS_URL=redis://localhost:6389/0

# LLM provider: "openrouter" or "groq" (app/core/factories.py). OpenRouter's free models
# share OpenRouter's own pooled capacity across every free-tier user, which is the real
# cause of sustained 429s — not the specific model. Groq's free tier runs on its own
# hardware with per-account limits, so it's the fallback when OpenRouter's pool saturates,
# not just a different model in the same pool. LLM_MODEL means a Groq model id when
# LLM_PROVIDER=groq (e.g. llama-3.3-70b-versatile) — check https://console.groq.com/docs/models.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
GROQ_API_KEY=
# nvidia/nemotron-3.5-lightning:free — verify this still exists at
# https://openrouter.ai/api/v1/models before relying on it; OpenRouter's free model list
# changes over time and individual models saturate independently of each other.
LLM_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_APP_NAME=Milieu
OPENROUTER_SITE_URL=https://github.com/milieu

# Embeddings
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Slack (next dispatch)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Misc
TENANT_ID=00000000-0000-0000-0000-000000000001
PROMPT_VERSION=1
SCHEMA_VERSION=1
