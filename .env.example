# Postgres / Redis (see docker-compose.yml for local port mapping)
DATABASE_URL=postgresql+psycopg://milieu:milieu@localhost:5544/milieu
REDIS_URL=redis://localhost:6389/0

# LLM provider (OpenRouter, OpenAI-compatible REST API; free-tier model by default)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# nvidia/nemotron-3-super-120b-a12b:free — largest free OpenRouter model (120B MoE, 12B active)
# that supports both structured_outputs and tools as of 2026-09-22. Verify this still exists
# at https://openrouter.ai/api/v1/models before relying on it.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_APP_NAME=Milieu
OPENROUTER_SITE_URL=https://github.com/milieu

# Embeddings
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Slack (next dispatch)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Misc
TENANT_ID=00000000-0000-0000-0000-000000000001
PROMPT_VERSION=1
SCHEMA_VERSION=1
